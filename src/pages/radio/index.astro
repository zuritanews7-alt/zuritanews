---
import Layout from '../../layouts/Layout.astro';

const radios = [
  // ========== 🇻🇪 VENEZUELA ==========
  {
    id: 'lider-923-merida',
    nombre: 'Líder 92.3 FM · Mérida',
    categoria: 'Venezuela',
    genero: 'Entretenimiento · Hits',
    initials: 'L9',
    url: 'http://acp4.lorini.net:15022/stream'
  },
  {
    id: 'lider-949-caracas',
    nombre: 'Líder 94.9 FM · Caracas',
    categoria: 'Venezuela',
    genero: 'Noticias · Deportes',
    initials: 'L9',
    url: 'http://acp4.lorini.net:15020/stream'
  },
  {
    id: 'rumba-venezuela',
    nombre: 'Rumba Venezuela FM',
    categoria: 'Venezuela',
    genero: 'Rumba · Tropical',
    initials: 'RV',
    url: 'https://stream.zeno.fm/dpndnvw6hwzuv'
  },
  {
    id: 'la-salsera',
    nombre: 'La Salsera FM',
    categoria: 'Venezuela',
    genero: 'Salsa · Latina',
    initials: 'LS',
    url: 'https://stream.zeno.fm/h7lnwv51bh5uv'
  },
  {
    id: 'rumbos',
    nombre: 'Radio Rumbos 670 AM',
    categoria: 'Venezuela',
    genero: 'Variado · Informativo',
    initials: 'RR',
    url: 'https://stream.zeno.fm/c3q3w8zfe18uv'
  },
  {
    id: 'fiesta-latina',
    nombre: 'Fiesta Latina 106.1 FM',
    categoria: 'Venezuela',
    genero: 'Latino · Variado',
    initials: 'FL',
    url: 'https://stream.zeno.fm/e2kzfpr34d0uv'
  },

  // ========== 🌎 LATINOAMÉRICA ==========
  {
    id: 'vallenato',
    nombre: 'Clásicos del Vallenato',
    categoria: 'Latinoamérica',
    genero: 'Vallenato',
    initials: 'CV',
    url: 'https://stream.zeno.fm/z07vyxbqz8quv'
  }
];

const categorias = ['Venezuela', 'Latinoamérica'];
---

<Layout title="ZuritaNews Radio — La señal que no se apaga">
  <div class="topbar">
    <div class="container topbar-inner">
      <div class="topbar-info">
        <span class="dot"></span>
        <span><b>EN VIVO</b> · Radio 24/7</span>
        <span>Caracas, VE</span>
      </div>
      <div class="topbar-social">
        <a href="https://wa.me/584249090007" target="_blank" title="WhatsApp">📱</a>
        <a href="https://t.me/+584249090007" target="_blank" title="Telegram">✈️</a>
      </div>
    </div>
  </div>

  <header class="site-header">
    <div class="container header-inner">
      <a class="logo" href="/">
        <span class="z-box">Z</span>
        <span>URITA<span class="news-tag">NEWS</span></span>
      </a>
      <nav class="main-nav">
        <a href="/">Inicio</a>
        <a href="/regionales">Regionales</a>
        <a href="/nacionales">Nacionales</a>
        <a href="/sucesos">Sucesos</a>
        <a href="/internacionales">Internacionales</a>
        <a href="/deportes">Deportes</a>
        <a href="/comunidades">Comunidades</a>
        <a class="live-link" href="/en-vivo">🔴 EN VIVO</a>
      </nav>
    </div>
  </header>

  <main class="main-content">
    <div class="container">

      <!-- HERO RADIO -->
      <section class="radio-hero">
        <div class="radio-hero-icon">🎙️</div>
        <div class="radio-hero-text">
          <h1>ZURITANEWS RADIO</h1>
          <p>La señal que no se apaga · 24/7</p>
        </div>
      </section>

      <!-- REPRODUCTOR PRINCIPAL -->
      <div class="radio-player-main">
        <div class="radio-player-inner">
          <div class="radio-now-playing">
            <div class="radio-eq" id="zn-eq">
              <span></span><span></span><span></span><span></span><span></span>
            </div>
            <div class="radio-now-text">
              <strong id="zn-now-name">Selecciona una emisora</strong>
              <small id="zn-now-genre">Haz clic en ▶ para escuchar</small>
            </div>
          </div>
          <div class="radio-controls">
            <button aria-label="Reproducir o pausar" class="radio-play-btn" id="zn-play-btn" type="button">▶</button>
            <div class="radio-volume">
              <span aria-hidden="true">🔊</span>
              <input aria-label="Volumen" id="zn-volume" max="100" min="0" type="range" value="80" />
            </div>
          </div>
        </div>
        <audio id="zn-audio" preload="none"></audio>
      </div>

      <!-- LISTADO DE EMISORAS POR CATEGORÍA -->
      {categorias.map(cat => {
        const radiosCat = radios.filter(r => r.categoria === cat);
        if (radiosCat.length === 0) return null;
        return (
          <div class="radio-categoria">
            <h2 class="radio-categoria-titulo">
              {cat === 'Venezuela' && '🇻🇪 '}
              {cat === 'Latinoamérica' && '🌎 '}
              {cat}
              <span class="radio-categoria-count">{radiosCat.length} emisoras</span>
            </h2>
            <div class="radio-grid">
              {radiosCat.map(radio => (
                <div class="radio-card" data-id={radio.id} data-url={radio.url} data-nombre={radio.nombre} data-genero={radio.genero}>
                  <div class="radio-logo">{radio.initials}</div>
                  <div class="radio-info">
                    <div class="radio-name">{radio.nombre}</div>
                    <div class="radio-genre">{radio.genero}</div>
                  </div>
                  <button class="radio-play-mini" type="button">▶</button>
                </div>
              ))}
            </div>
          </div>
        );
      })}

      <div style="text-align:center;margin-top:40px;">
        <a class="volver" href="/">← Volver al inicio</a>
      </div>

    </div>
  </main>

  <footer class="site-footer">
    <div class="container">
      <div class="footer-bottom">
        © 2026 ZuritaNews — Todos los derechos reservados.
      </div>
    </div>
  </footer>

  <script is:inline>
    (function(){
      var audio = document.getElementById('zn-audio');
      var playBtn = document.getElementById('zn-play-btn');
      var volume = document.getElementById('zn-volume');
      var nowName = document.getElementById('zn-now-name');
      var nowGenre = document.getElementById('zn-now-genre');
      var eq = document.getElementById('zn-eq');
      var currentId = null;

      if (audio) audio.volume = 0.8;

      function resetCards() {
        document.querySelectorAll('.radio-card').forEach(function(c){
          c.classList.remove('playing');
          var btn = c.querySelector('.radio-play-mini');
          if (btn) btn.textContent = '▶';
        });
      }

      function actualizarUI(playing) {
        if (!eq || !playBtn) return;
        if (playing) {
          eq.classList.add('active');
          playBtn.textContent = '⏸';
        } else {
          eq.classList.remove('active');
          playBtn.textContent = '▶';
        }
      }

      function playRadio(card) {
        var id = card.getAttribute('data-id');
        var url = card.getAttribute('data-url');
        var nombre = card.getAttribute('data-nombre');
        var genero = card.getAttribute('data-genero');

        // Si es la misma y está reproduciendo → pausar
        if (currentId === id && !audio.paused) {
          audio.pause();
          actualizarUI(false);
          resetCards();
          currentId = null;
          return;
        }

        // Detener todas
        resetCards();

        // Reproducir esta
        audio.src = url;
        audio.load();
        audio.play().then(function(){
          actualizarUI(true);
          card.classList.add('playing');
          var btn = card.querySelector('.radio-play-mini');
          if (btn) btn.textContent = '⏸';
          nowName.textContent = nombre;
          nowGenre.textContent = genero;
          currentId = id;
        }).catch(function(err){
          console.error('Error:', err);
          nowName.textContent = 'Error al reproducir';
          nowGenre.textContent = 'Prueba con otra emisora';
        });
      }

      // Click en card
      document.querySelectorAll('.radio-card').forEach(function(card){
        card.addEventListener('click', function(e){
          e.stopPropagation();
          playRadio(card);
        });
      });

      // Botón principal
      if (playBtn) {
        playBtn.addEventListener('click', function(){
          if (!audio.src) {
            var first = document.querySelector('.radio-card');
            if (first) playRadio(first);
            return;
          }
          if (audio.paused) {
            audio.play().then(function(){ actualizarUI(true); });
          } else {
            audio.pause();
            actualizarUI(false);
          }
        });
      }

      // Volumen
      if (volume) {
        volume.addEventListener('input', function(){
          audio.volume = this.value / 100;
        });
      }

      // Manejo de errores
      if (audio) {
        audio.addEventListener('error', function(){
          nowName.textContent = 'Canal no disponible';
          nowGenre.textContent = 'Prueba con otra emisora';
          actualizarUI(false);
          resetCards();
          currentId = null;
        });
      }
    })();
  </script>

  <style>
    /* HERO */
    .radio-hero {
      display: flex;
      align-items: center;
      gap: 20px;
      padding: 32px;
      background: linear-gradient(135deg, #0A1220 0%, #111C30 50%, #1A2A45 100%);
      border-radius: 16px;
      border: 1px solid rgba(0, 168, 232, 0.2);
      margin-bottom: 24px;
    }

    .radio-hero-icon {
      font-size: 56px;
      line-height: 1;
    }

    .radio-hero h1 {
      font-family: var(--font-display);
      font-size: 32px;
      color: #fff;
      margin: 0 0 6px;
      letter-spacing: 2px;
    }

    .radio-hero p {
      color: #B8C5D6;
      font-size: 14px;
      margin: 0;
      letter-spacing: 1px;
    }

    /* PLAYER PRINCIPAL */
    .radio-player-main {
      background: rgba(10, 18, 32, 0.95);
      border: 1px solid rgba(0, 168, 232, 0.3);
      border-radius: 12px;
      padding: 16px 20px;
      margin-bottom: 40px;
    }

    .radio-player-inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      flex-wrap: wrap;
    }

    .radio-now-playing {
      display: flex;
      align-items: center;
      gap: 14px;
      flex: 1;
      min-width: 220px;
    }

    .radio-eq {
      display: flex;
      align-items: flex-end;
      gap: 3px;
      height: 28px;
      width: 30px;
    }

    .radio-eq span {
      display: block;
      width: 4px;
      background: #00A8E8;
      border-radius: 2px;
      height: 30%;
    }

    .radio-eq.active span {
      animation: radio-eq 0.8s ease-in-out infinite;
      background: linear-gradient(180deg, #FF8C1A, #E63946);
    }

    .radio-eq.active span:nth-child(2) { animation-delay: 0.15s; }
    .radio-eq.active span:nth-child(3) { animation-delay: 0.3s; }
    .radio-eq.active span:nth-child(4) { animation-delay: 0.1s; }
    .radio-eq.active span:nth-child(5) { animation-delay: 0.25s; }

    @keyframes radio-eq {
      0%, 100% { height: 20%; }
      50% { height: 100%; }
    }

    .radio-now-text strong {
      color: #fff;
      font-size: 15px;
      display: block;
      margin-bottom: 2px;
    }

    .radio-now-text small {
      color: #B8C5D6;
      font-size: 12px;
    }

    .radio-controls {
      display: flex;
      align-items: center;
      gap: 16px;
    }

    .radio-play-btn {
      width: 48px;
      height: 48px;
      border-radius: 50%;
      background: linear-gradient(135deg, #00A8E8, #0057FF);
      border: none;
      color: white;
      font-size: 18px;
      cursor: pointer;
      transition: transform 0.2s ease;
    }

    .radio-play-btn:hover {
      transform: scale(1.08);
    }

    .radio-volume {
      display: flex;
      align-items: center;
      gap: 8px;
      color: #B8C5D6;
      font-size: 14px;
    }

    .radio-volume input {
      width: 90px;
      accent-color: #00A8E8;
    }

    /* CATEGORÍAS */
    .radio-categoria {
      margin-bottom: 40px;
    }

    .radio-categoria-titulo {
      font-family: var(--font-display);
      font-size: 18px;
      color: var(--text);
      margin-bottom: 16px;
      padding-bottom: 10px;
      border-bottom: 2px solid var(--border);
      text-transform: uppercase;
      letter-spacing: 1px;
      display: flex;
      align-items: center;
      gap: 10px;
      flex-wrap: wrap;
    }

    .radio-categoria-count {
      font-family: var(--font-body);
      font-size: 12px;
      color: var(--text-3);
      text-transform: none;
      letter-spacing: 0;
      font-weight: 400;
      margin-left: auto;
    }

    /* GRID RADIO */
    .radio-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
      gap: 14px;
    }

    .radio-card {
      display: flex;
      align-items: center;
      gap: 14px;
      padding: 14px;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 12px;
      cursor: pointer;
      transition: all 0.25s ease;
    }

    .radio-card:hover {
      border-color: var(--primary);
      transform: translateY(-3px);
      box-shadow: 0 8px 24px rgba(0, 168, 232, 0.2);
    }

    .radio-card.playing {
      border-color: var(--accent);
      background: linear-gradient(135deg, rgba(255, 140, 26, 0.08), rgba(0, 168, 232, 0.05));
      box-shadow: 0 8px 24px rgba(255, 140, 26, 0.25);
    }

    .radio-logo {
      width: 52px;
      height: 52px;
      border-radius: 10px;
      background: linear-gradient(135deg, #0A1220, #1A2A45);
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: 'Archivo Black', sans-serif;
      font-size: 18px;
      color: #00A8E8;
      flex-shrink: 0;
      border: 1px solid rgba(0, 168, 232, 0.2);
    }

    .radio-card.playing .radio-logo {
      background: linear-gradient(135deg, #FF8C1A, #E63946);
      color: white;
      border-color: transparent;
    }

    .radio-info {
      flex: 1;
      min-width: 0;
    }

    .radio-name {
      color: var(--text);
      font-weight: 700;
      font-size: 13px;
      margin-bottom: 3px;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .radio-genre {
      color: var(--text-3);
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    .radio-play-mini {
      width: 36px;
      height: 36px;
      border-radius: 50%;
      background: linear-gradient(135deg, #00A8E8, #0057FF);
      border: none;
      color: white;
      font-size: 14px;
      cursor: pointer;
      flex-shrink: 0;
      transition: transform 0.2s ease;
    }

    .radio-play-mini:hover {
      transform: scale(1.1);
    }

    .radio-card.playing .radio-play-mini {
      background: linear-gradient(135deg, #FF8C1A, #E63946);
    }

    @media (max-width: 768px) {
      .radio-hero {
        padding: 20px;
      }
      .radio-hero h1 {
        font-size: 22px;
      }
      .radio-hero-icon {
        font-size: 40px;
      }
      .radio-grid {
        grid-template-columns: 1fr;
      }
      .radio-categoria-titulo {
        font-size: 15px;
      }
    }
  </style>
</Layout>