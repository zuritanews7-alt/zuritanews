const categorias = ['Venezuela', 'Latinoamérica', 'Español', 'Internacional', 'España'];
---

<Layout title="Canales en Vivo — ZuritaNews">
  <div class="topbar">
    <div class="container topbar-inner">
      <div class="topbar-info">
        <span class="dot"></span>
        <span><b>EN VIVO</b> · Cobertura 24/7</span>
        <span>Caracas, VE</span>
      </div>
      <div class="topbar-social">
        <a href="https://wa.me/584249090007" target="_blank" title="WhatsApp">📱</a>
        <a href="https://t.me/+584249090007" target="_blank" title="Telegram">✈️</a>
      </div>
    </div>
  </div>

  <header class="site-header">
    <div class="container header-inner">
      <a class="logo" href="/">
        <span class="z-box">Z</span>
        <span>URITA<span class="news-tag">NEWS</span></span>
      </a>
      <nav class="main-nav">
        <a href="/">Inicio</a>
        <a href="/regionales">Regionales</a>
        <a href="/nacionales">Nacionales</a>
        <a href="/sucesos">Sucesos</a>
        <a href="/internacionales">Internacionales</a>
        <a href="/deportes">Deportes</a>
        <a href="/comunidades">Comunidades</a>
        <a class="live-link" href="/en-vivo">🔴 EN VIVO</a>
      </nav>
    </div>
  </header>

  <main class="main-content">
    <div class="container">

      <div class="section-head">
        <h2>📺 Canales de Noticias en Vivo</h2>
        <span class="section-badge">{canalesNoticias.length} canales</span>
      </div>

      <p class="section-desc">
        Señales oficiales de noticias 24/7 de Venezuela y el mundo. Haz clic en cualquier canal para verlo.
      </p>

      {categorias.map(cat => {
        const canalesCat = canalesNoticias.filter(c => c.categoria === cat);
        if (canalesCat.length === 0) return null;
        return (
          <div class="categoria-grupo">
            <h3 class="categoria-titulo">
              {cat === 'Venezuela' && '🇻🇪 '}
              {cat === 'Latinoamérica' && '🌎 '}
              {cat === 'Español' && '🌐 '}
              {cat === 'Internacional' && '🌍 '}
              {cat === 'España' && '🇪🇸 '}
              {cat}
            </h3>
            <div class="tv-grid">
              {canalesCat.map(canal => (
                <div class="tv-card" data-stream={canal.stream}>
                  <div class="tv-video-wrap">
                    <div class="tv-facade">
                      <img src={canal.logo} alt={canal.nombre} class="tv-logo" />
                      <button class="tv-play-btn" type="button">▶ Ver en vivo</button>
                    </div>
                    <iframe class="tv-player" allow="autoplay; encrypted-media; picture-in-picture; fullscreen" allowfullscreen style="display:none;"></iframe>
                  </div>
                  <div class="tv-info">
                    <div class="tv-nombre">{canal.nombre}</div>
                    <div class="tv-meta">
                      <span class="tv-pais">{canal.pais}</span>
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </div>
        );
      })}

      <div style="text-align:center;margin-top:40px;">
        <a class="volver" href="/">← Volver al inicio</a>
      </div>

    </div>
  </main>

  <footer class="site-footer">
    <div class="container">
      <div class="footer-bottom">
        © 2026 ZuritaNews — Todos los derechos reservados.
      </div>
    </div>
  </footer>

  <script is:inline>
    (function(){
      function limpiarOtros(iframeActual) {
        document.querySelectorAll('.tv-player').forEach(function(f){
          if (f !== iframeActual) {
            f.src = '';
            f.style.display = 'none';
          }
        });
        document.querySelectorAll('.tv-card').forEach(function(card){
          var facade = card.querySelector('.tv-facade');
          var iframe = card.querySelector('.tv-player');
          if (iframe !== iframeActual && facade) facade.style.display = 'flex';
        });
      }

      function reproducir(card) {
        var iframe = card.querySelector('.tv-player');
        var facade = card.querySelector('.tv-facade');
        var url = card.getAttribute('data-stream');

        limpiarOtros(iframe);
        facade.style.display = 'none';
        iframe.style.display = 'block';
        iframe.src = url;
      }

      document.querySelectorAll('.tv-play-btn').forEach(function(btn){
        btn.addEventListener('click', function(e){
          e.stopPropagation();
          reproducir(btn.closest('.tv-card'));
        });
      });
    })();
  </script>

  <style>
    .section-badge {
      padding: 6px 12px;
      background: var(--surface);
      border-radius: 100px;
      border: 1px solid var(--border);
      font-size: 12px;
      color: var(--text-3);
      text-transform: uppercase;
      letter-spacing: 1px;
    }

    .section-desc {
      color: var(--text-3);
      font-size: 14px;
      margin-bottom: 24px;
      line-height: 1.6;
    }

    .categoria-grupo {
      margin-bottom: 40px;
    }

    .categoria-titulo {
      font-family: var(--font-display);
      font-size: 18px;
      color: var(--text);
      margin-bottom: 16px;
      padding-bottom: 10px;
      border-bottom: 2px solid var(--border);
      text-transform: uppercase;
      letter-spacing: 1px;
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .tv-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
      gap: 20px;
    }

    .tv-card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 8px;
      overflow: hidden;
      transition: all 0.25s ease;
    }

    .tv-card:hover {
      border-color: var(--primary);
      transform: translateY(-2px);
    }

    .tv-video-wrap {
      position: relative;
      padding-bottom: 56.25%;
      background: #000;
    }

    .tv-player {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      border: 0;
      background: #000;
    }

    .tv-facade {
      position: absolute;
      inset: 0;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 14px;
      background: linear-gradient(135deg, #0A1220, #1A2A45);
      z-index: 2;
      padding: 20px;
      text-align: center;
    }

    .tv-logo {
      max-height: 60px;
      max-width: 80%;
      object-fit: contain;
      filter: brightness(1.2);
    }

    .tv-play-btn {
      background: linear-gradient(135deg, var(--primary), var(--primary-dark));
      border: none;
      color: #fff;
      padding: 10px 22px;
      border-radius: 8px;
      font-weight: 700;
      font-size: 13px;
      cursor: pointer;
      letter-spacing: 1px;
      text-transform: uppercase;
      box-shadow: 0 8px 24px rgba(0, 168, 232, 0.4);
      font-family: var(--font-body);
    }

    .tv-play-btn:hover {
      background: linear-gradient(135deg, var(--accent), #E63946);
    }

    .tv-info { padding: 12px 16px; }

    .tv-nombre {
      font-weight: 700;
      color: var(--text);
      font-size: 14px;
      margin-bottom: 4px;
    }

    .tv-meta {
      display: flex;
      gap: 8px;
      font-size: 10px;
      text-transform: uppercase;
      color: var(--text-3);
    }

    @media (max-width: 768px) {
      .tv-grid {
        grid-template-columns: 1fr;
      }
      .categoria-titulo {
        font-size: 15px;
      }
    }
  </style>
</Layout>